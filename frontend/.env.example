# TS Technology Frontend Environment Configuration Example

# Development on local machine:
# VITE_API_URL=http://127.0.0.1:8000/api

# Development on Local Area Network (LAN):
# Replace 192.168.1.7 with your host machine's IP address:
VITE_API_URL=http://192.168.1.7:8000/api

# Production Deployment:
# VITE_API_URL=https://api.your-ts-technology-domain.com/api
