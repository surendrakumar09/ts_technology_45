# Django Core Settings
SECRET_KEY=your-production-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.render.com,.railway.app

# Database Configuration (MySQL Production)
DB_ENGINE=django.db.backends.mysql
DB_NAME=ts_technology_db
DB_USER=ts_user
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=3306

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-site.netlify.app

# Email / SMTP Configuration (Gmail Production SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tssoftwaretechnology@gmail.com
# Use a 16-character Google App Password (not your regular Gmail password):
# Generate at: Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_HOST_PASSWORD=your_16_char_gmail_app_password
DEFAULT_FROM_EMAIL=tssoftwaretechnology@gmail.com
SERVER_EMAIL=tssoftwaretechnology@gmail.com
CONTACT_NOTIFICATION_EMAIL=tssoftwaretechnology@gmail.com
